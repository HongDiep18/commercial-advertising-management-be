# Application
APP_PORT=3000
APP_ENV=development
API_PREFIX=api/v1
INTERNAL_API_KEY=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# JWT (Dual-token system per protect.md)
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=example_access_secret_replace_with_64_char_hex_string_here_1234567890abcdef
JWT_REFRESH_SECRET=example_refresh_secret_replace_with_64_char_hex_string_here_0987654321fedcba
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Deprecated (for backward compatibility)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Super Admin Seed
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# News / RSS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEWS_SCHEDULE_ENABLED=true
NEWS_CRON=0 */15 * * * *
NEWS_TRANSLATE_BATCH_SIZE=5
NEWS_MAX_CONTENT_CHARS=4000
# RSS_SOURCES=   # optional JSON array to override default feed list

FRONTEND_URL=

# Chatbot config
CHATBOT_API_KEY=
CRAWL4AI_API_TOKEN=
CRAWL4AI_URL=http://crawl4ai:11235
# Frontend URL — used by crawler and for link generation in bot replies
CHATBOT_BASE_URL=http://localhost:3000
CHATBOT_CRAWL_SCHEDULE_ENABLED=true
CHATBOT_CRAWL_CRON=0 3 * * 0
CHATBOT_SESSION_CLEANUP_CRON=0 2 * * *

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=vn-buyer-guide-chatbot