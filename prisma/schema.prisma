generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── News ───────────────────────────────────────────────────────────

model NewsArticle {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceSite     String   @db.VarChar(64)
  sourceCategory String?  @db.VarChar(256)
  url            String   @unique @db.VarChar(2048)
  guid           String?  @db.VarChar(512)
  title          String   @db.VarChar(1024)
  publishedAt    DateTime
  thumbnailUrl   String?  @db.VarChar(2048)
  language       String   @default("vi") @db.VarChar(16)
  contentText    String?  @db.Text
  rawHtml        String?  @db.Text

  status       String  @default("DRAFT") @db.VarChar(16)
  aiSummaryVi   String? @db.Text
  aiSummaryZhTw String? @db.Text
  aiSummaryEn   String? @db.Text
  aiModel      String? @db.VarChar(128)
  summarizedAt DateTime?

  tags NewsArticleTag[]

  @@index([sourceSite])
  @@index([guid])
  @@map("news_articles")
}

model NewsTag {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug String @unique @db.VarChar(128)
  name String @db.VarChar(256)

  articles NewsArticleTag[]

  @@map("news_tags")
}

model NewsArticleTag {
  articleId String
  tagId     String

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("news_article_tags")
}
